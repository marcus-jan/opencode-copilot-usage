{
  "name": "opencode-copilot-usage-sidebar",
  "version": "0.2.4",
  "description": "Copilot account usage in the OpenCode sidebar and a separate home footer line",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcus-jan/opencode-copilot-usage.git"
  },
  "homepage": "https://github.com/marcus-jan/opencode-copilot-usage#readme",
  "bugs": { "url": "https://github.com/marcus-jan/opencode-copilot-usage/issues" },
  "keywords": ["opencode", "opencode-plugin", "github-copilot", "usage", "tui"],
  "exports": {
    ".": "./index.ts",
    "./tui": "./dist/tui.js",
    "./rpc": "./rpc.ts"
  },
  "files": ["index.ts", "tui.tsx", "rpc.ts", "src", "dist", "docs/screenshots", "LICENSE", "NOTICE", "README.md"],
  "scripts": {
    "build:tui": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload @opentui/solid/preload test",
    "check": "bun run build:tui && bun run --bun typecheck && bun run test"
  },
  "engines": { "bun": ">=1.3.14", "node": ">=26.4.0" },
  "dependencies": { "@opencode/plugin": "2.1.4" },
  "peerDependencies": {
    "@opencode/theme": "2.1.4",
    "@opentui/core": ">=0.6.8",
    "@opentui/solid": ">=0.6.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.1.4",
    "@opentui/core": "0.6.8",
    "@opentui/solid": "0.6.8",
    "@types/node": "^22.0.0",
    "@types/bun": "^1.4.1",
    "solid-js": "1.9.12",
    "typescript": "^5.9.0"
  }
}
